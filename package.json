{
  "name": "blue-paradise-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MongoDB API for the Blue Paradise Water Club web application",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "audit:db": "node scripts/auditDatabase.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test test/app.test.js test/dateRange.test.js test/models.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "morgan": "^1.10.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  }
}
